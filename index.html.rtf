function setLang(lang)\{\par
    document.querySelectorAll('[data-i18n]').forEach(el=>\{\par
        const key = el.getAttribute('data-i18n');\par
        if(translations[lang] && translations[lang][key])\{\par
            el.textContent = translations[lang][key];\par
        \}\par
    \});\par
    document.querySelectorAll('.lang-switcher button').forEach(b=>b.classList.remove('active'));\par
    document.getElementById('btn-'+lang).classList.add('active');\par
    document.documentElement.lang = lang;\par
    localStorage.setItem('dobar_dan_lang', lang);\par
\}\par
\par
// Gespeicherte Sprache laden\par
const savedLang = localStorage.getItem('dobar_dan_lang') || 'de';\par
setLang(savedLang);\par
