<!-- HERO -->\par
<header class="hero">\par
    <div class="hero-content">\par
        <div class="hero-ornament">\u10022? \u10022? \u10022?</div>\par
        <h1><span data-i18n="hero_title_1">Weil Verstehen keine Sprache braucht \endash </span><br><em data-i18n="hero_title_2">aber eine Stimme.</em></h1>\par
        <h2><span data-i18n="hero_sub_1">Nicht irgendeine Stimme \endash  sondern eine, </span><em data-i18n="hero_sub_2">die zuh\'f6rt. Die versteht. Die bleibt.</em></h2>\par
        <p class="hero-sub" data-i18n="hero_text">Professionelle telefonische Seniorenbetreuung in Ihrer Muttersprache. Geschultes Fachpersonal aus dem Balkan. Premium-Erlebnistag. Individuelle Trainings. F\'fcr die Diaspora in Deutschland, \'d6sterreich und der Schweiz.</p>\par
