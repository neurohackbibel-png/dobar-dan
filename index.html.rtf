<!-- TRAININGS -->\par
<section class="trainings" id="trainings">\par
    <div class="section-inner">\par
        <div class="section-label" data-i18n="tr_label">Individuelle Trainings</div>\par
        <h2 class="section-title"><span data-i18n="tr_title_1">Spa\'df. Fitness. Wohlbefinden.</span><br><em data-i18n="tr_title_2">Telefonisch angeleitet.</em></h2>\par
        <p class="section-text" data-i18n="tr_text">Unsere individuellen Trainings sind keine Pflicht\'fcbungen. Sie sind Einladungen \endash  zum Lachen, zum Bewegen, zum Erinnern. In jedem Paket zubuchbar \endash  ab 29 \'80 pro Einheit.</p>\par
        <div class="training-grid">\par
            <div class="training-card"><span class="training-icon">\u-10178?\u-8736?</span><h3 data-i18n="tr1_t">Ged\'e4chtnis-Quiz</h3><p data-i18n="tr1_d">Spielerische \'dcbungen f\'fcr die grauen Zellen.</p></div>\par
